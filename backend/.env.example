PORT=3000

# ID do projeto Firebase; não use a chave web para autenticar o backend.
FIREBASE_PROJECT_ID=monark-7d352

# Use o JSON completo da conta de serviço ou, localmente, informe o caminho do arquivo.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Credenciais de teste do Mercado Pago. Nunca use Public Key no servidor.
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_DE_TESTE
MP_WEBHOOK_SECRET=SUA_ASSINATURA_SECRETA_DO_WEBHOOK

# Opcional: URL pública do frontend; na Vercel, o domínio é detectado automaticamente.
FRONTEND_URL=http://127.0.0.1:5500

# Opcional: URL pública estável do webhook; na Vercel, o domínio é detectado automaticamente.
WEBHOOK_URL=

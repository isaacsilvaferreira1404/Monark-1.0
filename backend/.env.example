PORT=3000

# ID do projeto Firebase; não use a chave web para autenticar o backend.
FIREBASE_PROJECT_ID=monark-7d352

# Para hospedagem, configure o JSON completo da conta de serviço como variável secreta.
# Localmente, você também pode usar o caminho do arquivo abaixo.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=C:/caminho/seguro/monark-firebase-service-account.json

# Credenciais de teste do Mercado Pago. Nunca use Public Key no servidor.
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_DE_TESTE
MP_WEBHOOK_SECRET=SUA_ASSINATURA_SECRETA_DO_WEBHOOK

# URL completa do frontend; em GitHub Pages de projeto, inclua /nome-do-repositorio.
FRONTEND_URL=http://127.0.0.1:5500

# Opcional: no Render, o servidor monta esta URL automaticamente.
WEBHOOK_URL=
